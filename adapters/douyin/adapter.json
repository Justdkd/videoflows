{
  "id": "douyin",
  "mode": "browser_readonly",
  "readonly": true,
  "needs": [
    "用户电脑开着",
    "用户说了「电脑开着，可以读」",
    "用户自己的 Chrome 已登录抖音创作者服务中心"
  ],
  "steps": "adapters/douyin/steps.md",
  "metrics": [
    "plays",
    "bounce_2s",
    "completion_5s",
    "avg_watch_ratio",
    "likes",
    "comments",
    "shares",
    "favorites",
    "new_followers"
  ],
  "play_definition": "播放量",
  "input": "{card, platform, url, post_id, published_at, point}",
  "output": "{point, taken_at, source, read_by, metrics, missing}，即 card.schema.json 里 publications[].samples[] 的一项"
}
